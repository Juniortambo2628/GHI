<?php
/**
 * Our Impact Page
 * Global Harmony Initiative Website
 */

// Load configuration first
require_once __DIR__ . '/config/config.php';

use GHI\Models\Event;
use GHI\Models\ImpactActivity;
use GHI\Models\Initiative;

$pageTitle = 'Our Impact - ' . SITE_NAME;
$pageDescription = 'Discover the positive impact we are making in East Africa through our programs and initiatives.';

require_once __DIR__ . '/includes/header.php';

// Pagination
$itemsPerPage = 12;
$currentPage = isset($_GET['page']) ? (int)$_GET['page'] : 1;
$currentPage = max(1, $currentPage);

// Search
$search = isset($_GET['search']) ? trim($_GET['search']) : '';

// Filters
$filters = [
    'region' => [
        'label' => 'Region',
        'type' => 'select',
        'options' => [
            'kenya' => 'Kenya',
            'tanzania' => 'Tanzania',
            'uganda' => 'Uganda',
            'rwanda' => 'Rwanda',
        ],
    ],
    'objective' => [
        'label' => 'Core Objective',
        'type' => 'select',
        'options' => [
            'poverty' => 'Poverty Alleviation & Livelihoods',
            'education' => 'Education Access & Youth Development',
            'health' => 'Health & Well-being',
            'empowerment' => 'Community Empowerment',
            'partnerships' => 'Global Partnerships & Awareness',
        ],
    ],
];

// Get impact activities from database
$impactModel = new ImpactActivity();
$conditions = ['status' => 'published'];
$orderBy = 'display_order ASC, created_at DESC';
$allImpacts = $impactModel->all($conditions, $orderBy);

// Get events and initiatives for location/region extraction and objective mapping
$eventModel = new Event();
$initiativeModel = new Initiative();
$allEvents = $eventModel->all(['status' => 'published'], 'event_date DESC');
$allInitiatives = $initiativeModel->all(['status' => 'published'], 'created_at DESC');

$eventsById = [];
foreach ($allEvents as $event) {
    $eventsById[$event['id']] = $event;
}

$initiativesById = [];
foreach ($allInitiatives as $initiative) {
    $initiativesById[$initiative['id']] = $initiative;
}

// Category to objective mapping
$categoryToObjective = [
    'livelihood' => 'poverty',
    'education' => 'education',
    'health' => 'health',
    'empowerment' => 'empowerment',
    'partnerships' => 'partnerships',
];

// Extract region from location and add to impact data
foreach ($allImpacts as &$impact) {
    $event = $eventsById[$impact['event_id']] ?? null;
    if ($event) {
        // Extract region from location (e.g., "Nairobi, Kenya" -> "kenya")
        $location = strtolower($event['location'] ?? '');
        if (strpos($location, 'kenya') !== false) {
            $impact['region'] = 'kenya';
        } elseif (strpos($location, 'tanzania') !== false) {
            $impact['region'] = 'tanzania';
        } elseif (strpos($location, 'uganda') !== false) {
            $impact['region'] = 'uganda';
        } elseif (strpos($location, 'rwanda') !== false) {
            $impact['region'] = 'rwanda';
        } else {
            $impact['region'] = 'kenya'; // Default
        }
        $impact['date'] = $event['event_date'];

        // Get objective from event's initiative category
        if ($event['initiative_id'] && isset($initiativesById[$event['initiative_id']])) {
            $initiative = $initiativesById[$event['initiative_id']];
            $category = $initiative['category'] ?? 'livelihood';
            $impact['objective'] = $categoryToObjective[$category] ?? 'poverty';
        } else {
            $impact['objective'] = 'poverty'; // Default
        }
    } else {
        $impact['region'] = 'kenya';
        $impact['date'] = $impact['created_at'];
        $impact['objective'] = 'poverty'; // Default
    }
    $impact['lives_impacted'] = $impact['people_affected'];
}
unset($impact);

// Apply filters
$filteredImpacts = $allImpacts;
if (! empty($search)) {
    $filteredImpacts = array_filter($filteredImpacts, function ($impact) use ($search) {
        return stripos($impact['title'], $search) !== false || stripos($impact['description'], $search) !== false;
    });
}

if (isset($_GET['filter']['region']) && ! empty($_GET['filter']['region'])) {
    $filteredImpacts = array_filter($filteredImpacts, function ($impact) {
        return $impact['region'] === $_GET['filter']['region'];
    });
}

if (isset($_GET['filter']['objective']) && ! empty($_GET['filter']['objective'])) {
    $filteredImpacts = array_filter($filteredImpacts, function ($impact) {
        return $impact['objective'] === $_GET['filter']['objective'];
    });
}

$filteredImpacts = array_values($filteredImpacts);
$totalItems = count($filteredImpacts);
$totalPages = ceil($totalItems / $itemsPerPage);
$offset = ($currentPage - 1) * $itemsPerPage;
$impacts = array_slice($filteredImpacts, $offset, $itemsPerPage);

// Sidebar options
$sidebarOptions = [
    'page_title' => 'Our Impact',
    'show_search' => true,
    'show_filters' => true,
    'filters' => $filters,
    'current_page' => $currentPage,
    'total_pages' => $totalPages,
    'total_items' => $totalItems,
    'items_per_page' => $itemsPerPage,
    'base_url' => BASE_URL . '/impact.php',
    'current_page_name' => 'impact',
];
?>

<!-- Page Header Start -->
<div class="container-fluid page-header hero-impact mb-5">
    <div class="container py-5">
        <nav aria-label="breadcrumb animated slideInDown mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="<?php echo BASE_URL; ?>/index.php">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Our Impact</li>
            </ol>
        </nav>
        <h1 class="display-3 text-white mb-3 animated slideInDown">Our Impact</h1>
    </div>
</div>
<!-- Page Header End -->

<!-- Impact Start -->
<div class="container-fluid px-5">
    <div class="container-fluid px-5">
        <div class="row">
            <?php
            $options = $sidebarOptions;
require __DIR__ . '/includes/sidebar.php';
?>
            
            <div class="col-lg-9">
                <!-- Pagination Info and Grid/List Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <p class="mb-0">Showing <?php echo min(($currentPage - 1) * $itemsPerPage + 1, $totalItems); ?>-<?php echo min($currentPage * $itemsPerPage, $totalItems); ?> of <?php echo $totalItems; ?> results</p>
                    </div>
                    <?php
        $viewMode = 'grid';
$storageKey = 'viewMode_impact';
require __DIR__ . '/includes/grid-list-toggle.php';
?>
                </div>
                
                <!-- Content Container -->
                <div class="content-container <?php echo $viewMode; ?>-view mt-4">
                    <div class="row g-0">
                        <?php if (empty($impacts)): ?>
                            <div class="col-12">
                                <p class="text-center py-5">No impact stories found. Please try different search or filter criteria.</p>
                            </div>
                        <?php else: ?>
                            <?php foreach ($impacts as $impact): ?>
                                <div class="col-md-6 col-lg-4 listing-item">
                                    <div class="card">
                                        <img src="<?php echo getImageUrl($impact['image'] ?: $impact['thumbnail']); ?>" class="card-img-top" alt="<?php echo e($impact['title']); ?>">
                                        <span class="badge"><?php echo e(ucfirst($impact['region'])); ?></span>
                                        <?php
                    $objectiveLabels = [
                        'poverty' => 'Poverty Alleviation & Livelihoods',
                        'education' => 'Education Access & Youth Development',
                        'health' => 'Health & Well-being',
                        'empowerment' => 'Community Empowerment',
                        'partnerships' => 'Global Partnerships & Awareness',
                    ];
                                $objectiveLabel = $objectiveLabels[$impact['objective']] ?? 'Community Development';
                                ?>
                                        <span class="badge badge-right"><?php echo e($objectiveLabel); ?></span>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title"><?php echo e($impact['title']); ?></h5>
                                            <p class="card-text"><?php echo e(truncate($impact['description'], 100)); ?></p>
                                            <small class="text-white mb-2"><i class="fas fa-users me-1"></i><?php echo number_format($impact['lives_impacted']); ?> Lives Impacted</small>
                                            <small class="text-white mb-3"><i class="fas fa-calendar me-1"></i><?php echo formatDate($impact['date']); ?></small>
                                            <button class="btn btn-primary" onclick="openImpactModal(<?php echo htmlspecialchars(json_encode($impact), ENT_QUOTES, 'UTF-8'); ?>)">View Details</button>
                                        </div>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </div>
                </div>
                
                <!-- Pagination -->
                <?php
                $baseUrl = BASE_URL . '/impact.php';
require __DIR__ . '/includes/pagination.php';
?>
            </div>
        </div>
    </div>
</div>
<!-- Impact End -->

<!-- Modal -->
<?php
$modalId = 'impactModal';
$title = 'Impact Story Details';
require __DIR__ . '/includes/modal.php';
?>

<script>
function openImpactModal(impact) {
    // Construct full image URL
    const baseUrl = '<?php echo BASE_URL; ?>';
    const imageUrl = (impact.image || impact.thumbnail) ? `${baseUrl}/Banners-and-portraits/${impact.image || impact.thumbnail}` : null;
    
    const modalData = {
        title: impact.title,
        description: impact.description,
        image: imageUrl,
        thumbnail: imageUrl,
        meta: {
            'Region': impact.region.charAt(0).toUpperCase() + impact.region.slice(1),
            'Core Objective': impact.objective.charAt(0).toUpperCase() + impact.objective.slice(1),
            'Date': new Date(impact.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
            'Lives Impacted': impact.lives_impacted ? impact.lives_impacted.toLocaleString() : '0'
        },
        tags: [impact.region, impact.objective],
        action_url: '<?php echo BASE_URL; ?>/stories.php?impact=' + impact.id,
        action_text: 'Read Full Story'
    };
    openModal('impactModal', modalData);
}

function number_format(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}
</script>

<?php require_once __DIR__ . '/includes/footer.php'; ?>

