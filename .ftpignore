# DO NOT UPLOAD - Files and Directories to Exclude
# Use this as a reference when uploading via FTP

# Development files
node_modules/
.git/
.vscode/
.idea/

# Development documentation (already in docs/)
*.md

# Environment files (use .env.production instead)
.env
.env.local
.env.development

# Test files
tests/
phpunit.xml
vitest.config.js

# Build configuration files
vite.config.js
postcss.config.js
package.json
package-lock.json
composer.lock

# Source files (JS/CSS already built in dist/)
js/*.js
css/*.css
scss/

# Quality assurance tools
phpstan.neon
phpstan-baseline.neon
phpcs.xml
rector.php

# Cache and temporary files
cache/*
storage/logs/*
.DS_Store
Thumbs.db

# Documentation directory
docs/

# Development scripts
tests/scripts/
