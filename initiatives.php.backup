<?php
/**
 * Our Initiatives Page
 * Global Harmony Initiative Website
 */

// Load configuration first
require_once __DIR__ . '/config/config.php';

use GHI\Models\Initiative;

$pageTitle = 'Our Initiatives - ' . SITE_NAME;
$pageDescription = 'Explore our strategic initiatives designed to achieve our core objectives in East Africa.';

require_once __DIR__ . '/includes/header.php';

// Pagination
$itemsPerPage = 12;
$currentPage = isset($_GET['page']) ? (int)$_GET['page'] : 1;
$currentPage = max(1, $currentPage);

// Search
$search = isset($_GET['search']) ? trim($_GET['search']) : '';

// Filters
$filters = [
    'objective' => [
        'label' => 'Core Objective',
        'type' => 'select',
        'options' => [
            'poverty' => 'Poverty Alleviation & Livelihoods',
            'education' => 'Education Access & Youth Development',
            'health' => 'Health & Well-being',
            'empowerment' => 'Community Empowerment',
            'partnerships' => 'Global Partnerships & Awareness',
        ],
    ],
    'status' => [
        'label' => 'Status',
        'type' => 'select',
        'options' => [
            'active' => 'Active',
            'completed' => 'Completed',
            'planned' => 'Planned',
        ],
    ],
];

// Get initiatives from database
$initiativeModel = new Initiative();
$conditions = ['status' => 'published'];
$orderBy = 'created_at DESC';
$allInitiatives = $initiativeModel->all($conditions, $orderBy);

// Map category to objective for filtering
$categoryToObjective = [
    'livelihood' => 'poverty',
    'education' => 'education',
    'health' => 'health',
    'empowerment' => 'empowerment',
    'partnerships' => 'partnerships',
];

// Add event counts and map category to objective for each initiative
$db = \Database::getInstance();
foreach ($allInitiatives as &$initiative) {
    // Count events for this initiative
    $stmt = $db->prepare("SELECT COUNT(*) as total FROM events WHERE initiative_id = ? AND status = 'published'");
    $stmt->execute([$initiative['id']]);
    $eventCount = $stmt->fetch()['total'] ?? 0;
    $initiative['events_planned'] = $eventCount;
    $initiative['events_completed'] = $eventCount; // Simplified for now
    $initiative['objective'] = $categoryToObjective[$initiative['category']] ?? 'education';
}
unset($initiative);

// Apply filters
$filteredInitiatives = $allInitiatives;
if (! empty($search)) {
    $filteredInitiatives = array_filter($filteredInitiatives, function ($initiative) use ($search) {
        return stripos($initiative['title'], $search) !== false || stripos($initiative['description'], $search) !== false;
    });
}

if (isset($_GET['filter']['objective']) && ! empty($_GET['filter']['objective'])) {
    $filteredInitiatives = array_filter($filteredInitiatives, function ($initiative) {
        return $initiative['objective'] === $_GET['filter']['objective'];
    });
}

if (isset($_GET['filter']['status']) && ! empty($_GET['filter']['status'])) {
    $filteredInitiatives = array_filter($filteredInitiatives, function ($initiative) {
        return $initiative['status'] === $_GET['filter']['status'];
    });
}

$filteredInitiatives = array_values($filteredInitiatives);
$totalItems = count($filteredInitiatives);
$totalPages = ceil($totalItems / $itemsPerPage);
$offset = ($currentPage - 1) * $itemsPerPage;
$initiatives = array_slice($filteredInitiatives, $offset, $itemsPerPage);

// Sidebar options
$sidebarOptions = [
    'page_title' => 'Our Initiatives',
    'show_search' => true,
    'show_filters' => true,
    'filters' => $filters,
    'current_page' => $currentPage,
    'total_pages' => $totalPages,
    'total_items' => $totalItems,
    'items_per_page' => $itemsPerPage,
    'base_url' => BASE_URL . '/initiatives.php',
    'current_page_name' => 'initiatives',
];
?>

<!-- Page Header Start -->
<div class="container-fluid page-header hero-initiatives mb-5">
    <div class="container py-5">
        <nav aria-label="breadcrumb animated slideInDown mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="<?php echo BASE_URL; ?>/index.php">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Our Initiatives</li>
            </ol>
        </nav>
        <h1 class="display-3 text-white mb-3 animated slideInDown">Our Initiatives</h1>
    </div>
</div>
<!-- Page Header End -->

<!-- Initiatives Start -->
<div class="container-fluid px-5">
    <div class="container-fluid px-5">
        <div class="row">
            <?php
            $options = $sidebarOptions;
require __DIR__ . '/includes/sidebar.php';
?>
            
            <div class="col-lg-9">
                <!-- Pagination Info and Grid/List Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <p class="mb-0">Showing <?php echo min(($currentPage - 1) * $itemsPerPage + 1, $totalItems); ?>-<?php echo min($currentPage * $itemsPerPage, $totalItems); ?> of <?php echo $totalItems; ?> results</p>
                    </div>
                    <?php
        $viewMode = 'grid';
$storageKey = 'viewMode_initiatives';
require __DIR__ . '/includes/grid-list-toggle.php';
?>
                </div>
                
                <!-- Content Container -->
                <div class="content-container <?php echo $viewMode; ?>-view mt-4">
                    <div class="row g-0">
                        <?php if (empty($initiatives)): ?>
                            <div class="col-12">
                                <p class="text-center py-5">No initiatives found. Please try different search or filter criteria.</p>
                            </div>
                        <?php else: ?>
                            <?php foreach ($initiatives as $initiative):
                                $progress = $initiative['events_planned'] > 0 ? ($initiative['events_completed'] / $initiative['events_planned']) * 100 : 0;
                                ?>
                                <div class="col-md-6 col-lg-4 listing-item">
                                    <div class="card">
                                        <img src="<?php echo getImageUrl($initiative['image']); ?>" class="card-img-top" alt="<?php echo e($initiative['title']); ?>">
                                        <?php
                                            $categoryToObjective = [
                                                'education' => 'Education Access & Youth Development',
                                                'health' => 'Health & Well-being',
                                                'livelihood' => 'Poverty Alleviation & Livelihoods',
                                                'empowerment' => 'Community Empowerment',
                                                'partnerships' => 'Global Partnerships & Awareness',
                                            ];
                                $objectiveName = $categoryToObjective[$initiative['category']] ?? 'Community Development';
                                ?>
                                        <span class="badge"><?php echo e($objectiveName); ?></span>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title"><?php echo e($initiative['title']); ?></h5>
                                            <p class="card-text"><?php echo e(truncate($initiative['description'], 100)); ?></p>
                                            <div class="mb-3">
                                                <small class="text-white">Progress: <?php echo $initiative['events_completed']; ?>/<?php echo $initiative['events_planned']; ?> Events</small>
                                                <div class="progress initiative-progress-track">
                                                    <div class="progress-bar bg-secondary" role="progressbar" style="width: <?php echo $progress; ?>%" aria-valuenow="<?php echo $progress; ?>" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </div>
                                            <button class="btn btn-primary" onclick="openInitiativeModal(<?php echo htmlspecialchars(json_encode($initiative), ENT_QUOTES, 'UTF-8'); ?>)">View Details</button>
                                        </div>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </div>
                </div>
                
                <!-- Pagination -->
                <?php
                $baseUrl = BASE_URL . '/initiatives.php';
require __DIR__ . '/includes/pagination.php';
?>
            </div>
        </div>
    </div>
</div>
<!-- Initiatives End -->

<!-- Modal -->
<?php
$modalId = 'initiativeModal';
$title = 'Initiative Details';
require __DIR__ . '/includes/modal.php';
?>

<script>
function openInitiativeModal(initiative) {
    // Construct full image URL
    const baseUrl = '<?php echo BASE_URL; ?>';
    const imageUrl = initiative.image ? `${baseUrl}/Banners-and-portraits/${initiative.image}` : null;
    
    const modalData = {
        title: initiative.title,
        description: initiative.description,
        image: imageUrl,
        thumbnail: imageUrl,
        meta: {
            'Core Objective': initiative.objective.charAt(0).toUpperCase() + initiative.objective.slice(1),
            'Status': initiative.status.charAt(0).toUpperCase() + initiative.status.slice(1),
            'Events Planned': initiative.events_planned,
            'Events Completed': initiative.events_completed
        },
        tags: [initiative.objective, initiative.status],
        action_url: '<?php echo BASE_URL; ?>/events.php?initiative=' + initiative.id,
        action_text: 'View Events'
    };
    openModal('initiativeModal', modalData);
}
</script>

<?php require_once __DIR__ . '/includes/footer.php'; ?>

