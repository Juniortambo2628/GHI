=> 32, 'title' => 'Mentorship Changing Young Lives', 'slug' => 'mentorship-changing-young-lives', 'description' => 'An inspiring story of transformation and hope from our community programs.', 'content' => 'Community support makes all the difference. This story shows how collective action and shared resources can address challenges and create opportunities.', 'image' => 'pexels-finalchoice-147015110-34599374.jpg', 'category' => 'empowerment', 'likes' => 11, 'comments' => 29, 'status' => 'published', 'created_at' => '2025-10-30 17:40:23', 'updated_at' => '2025-11-08 09:05:22'], 4 => ['id' => 37, 'title' => 'Community Development Through Partnership', 'slug' => 'community-development-through-partnership', 'description' => 'An inspiring story of transformation and hope from our community programs.', 'content' => 'Youth leadership drives change. This story showcases young people who have taken on leadership roles and are making a difference in their communities.', 'image' => 'pexels-rdne-6646897.jpg', 'category' => 'education', 'likes' => 59, 'comments' => 23, 'status' => 'published', 'created_at' => '2025-10-29 22:32:12', 'updated_at' => '2025-11-08 09:05:22'], 5 => ['id' => 27, 'title' => 'Vocational Training Opening Doors', 'slug' => 'vocational-training-opening-doors', 'description' => 'An inspiring story of transformation and hope from our community programs.', 'content' => 'When communities come together with shared purpose, incredible things happen. This story celebrates the power of collective action and mutual support.', 'image' => 'pexels-speakmediauganda-34249567.jpg', 'category' => 'livelihood', 'likes' => 13, 'comments' => 50, 'status' => 'published', 'created_at' => '2025-10-21 18:44:17', 'updated_at' => '2025-11-08 09:05:22'], 6 => ['id' => 36, 'title' => 'Women\'s Empowerment Success Story', 'slug' => 'womens-empowerment-success-story', 'description' => 'An inspiring story of transformation and hope from our community programs.', 'content' => 'Partnershi