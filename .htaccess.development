# ===================================================================
# Development .htaccess for Global Harmony Initiative
# Use this for local development
# ===================================================================

# ===================================================================
# SECURITY (Basic)
# ===================================================================

# Disable directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env|\.git.*|\.htaccess\..*|config/.*\.php)$">
    Require all denied
</FilesMatch>

# Block access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ===================================================================
# DEVELOPMENT SETTINGS
# ===================================================================

# Show PHP errors for development
<IfModule mod_php7.c>
    php_flag display_errors On
    php_flag display_startup_errors On
    php_value error_reporting E_ALL
    php_flag log_errors On
</IfModule>

# ===================================================================
# ERROR PAGES
# ===================================================================

ErrorDocument 404 /GHI/404.php
ErrorDocument 403 /GHI/403.php
ErrorDocument 500 /GHI/500.php

# ===================================================================
# URL REWRITING
# ===================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /GHI/
    
    # Remove trailing slashes (except for directories and root)
    RewriteCond %{REQUEST_URI} !^/GHI/?$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]
    
    # Remove .php extension from URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# ===================================================================
# MIME TYPES
# ===================================================================

<IfModule mod_mime.c>
    AddType application/javascript js
    AddType text/css css
    AddType image/webp webp
    AddType font/woff woff
    AddType font/woff2 woff2
</IfModule>

# ===================================================================
# ENABLE SYMBOLIC LINKS
# ===================================================================

Options +FollowSymLinks

# ===================================================================
# UTF-8 ENCODING
# ===================================================================

AddDefaultCharset UTF-8

# ===================================================================
# END OF .htaccess
# ===================================================================

