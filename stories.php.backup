<?php
/**
 * Our Stories Page
 * Global Harmony Initiative Website
 */

// Load configuration first
require_once __DIR__ . '/config/config.php';

use GHI\Models\Story;

$pageTitle = 'Our Stories - ' . SITE_NAME;
$pageDescription = 'Read inspiring stories of impact, transformation, and hope from our work in East Africa.';

require_once __DIR__ . '/includes/header.php';

// Pagination
$itemsPerPage = 12;
$currentPage = isset($_GET['page']) ? (int)$_GET['page'] : 1;
$currentPage = max(1, $currentPage);

// Search
$search = isset($_GET['search']) ? trim($_GET['search']) : '';

// Filters
$filters = [
    'region' => [
        'label' => 'Region',
        'type' => 'select',
        'options' => [
            'kenya' => 'Kenya',
            'tanzania' => 'Tanzania',
            'uganda' => 'Uganda',
            'rwanda' => 'Rwanda',
        ],
    ],
    'category' => [
        'label' => 'Category',
        'type' => 'select',
        'options' => [
            'education' => 'Education',
            'health' => 'Health',
            'community' => 'Community',
            'empowerment' => 'Empowerment',
        ],
    ],
];

// Get stories from database
$storyModel = new Story();
$conditions = ['status' => 'published'];
$orderBy = 'created_at DESC';
$allStories = $storyModel->all($conditions, $orderBy);

// Add additional fields for compatibility
foreach ($allStories as &$story) {
    $story['date'] = $story['created_at'];
    $story['author'] = 'GHI Team';
    $story['shares'] = 0; // Not in database yet
    // Map category - stories use same categories as initiatives
    if (! in_array($story['category'], ['education', 'health', 'empowerment'])) {
        $story['category'] = 'community'; // Default for other categories
    }
    // Default region (can be enhanced)
    $story['region'] = 'kenya';
}
unset($story);

// Apply filters
$filteredStories = $allStories;
if (! empty($search)) {
    $filteredStories = array_filter($filteredStories, function ($story) use ($search) {
        return stripos($story['title'], $search) !== false || stripos($story['description'], $search) !== false;
    });
}

if (isset($_GET['filter']['region']) && ! empty($_GET['filter']['region'])) {
    $filteredStories = array_filter($filteredStories, function ($story) {
        return $story['region'] === $_GET['filter']['region'];
    });
}

if (isset($_GET['filter']['category']) && ! empty($_GET['filter']['category'])) {
    $filteredStories = array_filter($filteredStories, function ($story) {
        return $story['category'] === $_GET['filter']['category'];
    });
}

$filteredStories = array_values($filteredStories);
$totalItems = count($filteredStories);
$totalPages = ceil($totalItems / $itemsPerPage);
$offset = ($currentPage - 1) * $itemsPerPage;
$stories = array_slice($filteredStories, $offset, $itemsPerPage);

// Sidebar options
$sidebarOptions = [
    'page_title' => 'Our Stories',
    'show_search' => true,
    'show_filters' => true,
    'filters' => $filters,
    'current_page' => $currentPage,
    'total_pages' => $totalPages,
    'total_items' => $totalItems,
    'items_per_page' => $itemsPerPage,
    'base_url' => BASE_URL . '/stories.php',
    'current_page_name' => 'stories',
];
?>

<!-- Page Header Start -->
<div class="container-fluid page-header hero-stories mb-5">
    <div class="container py-5">
        <nav aria-label="breadcrumb animated slideInDown mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="<?php echo BASE_URL; ?>/index.php">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Our Stories</li>
            </ol>
        </nav>
        <h1 class="display-3 text-white mb-3 animated slideInDown">Our Stories</h1>
    </div>
</div>
<!-- Page Header End -->

<!-- Stories Start -->
<div class="container-fluid px-5">
    <div class="container-fluid px-5">
        <div class="row">
            <?php
            $options = $sidebarOptions;
require __DIR__ . '/includes/sidebar.php';
?>
            
            <div class="col-lg-9">
                <!-- Pagination Info and Grid/List Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <p class="mb-0">Showing <?php echo min(($currentPage - 1) * $itemsPerPage + 1, $totalItems); ?>-<?php echo min($currentPage * $itemsPerPage, $totalItems); ?> of <?php echo $totalItems; ?> results</p>
                    </div>
                    <?php
        $viewMode = 'grid';
$storageKey = 'viewMode_stories';
require __DIR__ . '/includes/grid-list-toggle.php';
?>
                </div>
                
                <!-- Content Container -->
                <div class="content-container <?php echo $viewMode; ?>-view mt-4">
                    <div class="row g-0">
                        <?php if (empty($stories)): ?>
                            <div class="col-12">
                                <p class="text-center py-5">No stories found. Please try different search or filter criteria.</p>
                            </div>
                        <?php else: ?>
                            <?php foreach ($stories as $story): ?>
                                <div class="col-md-6 col-lg-4 listing-item">
                                    <div class="card">
                                        <img src="<?php echo getImageUrl($story['image']); ?>" class="card-img-top" alt="<?php echo e($story['title']); ?>">
                                        <span class="badge"><?php echo e(ucfirst($story['region'])); ?></span>
                                        <span class="badge badge-right"><?php echo e(ucfirst($story['category'])); ?></span>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title"><?php echo e($story['title']); ?></h5>
                                            <p class="card-text"><?php echo e(truncate($story['description'], 100)); ?></p>
                                            <small class="text-white mb-2"><i class="fas fa-calendar me-1"></i><?php echo formatDate($story['date']); ?></small>
                                            <small class="text-white mb-3"><i class="fas fa-user me-1"></i><?php echo e($story['author']); ?></small>
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <button class="btn btn-sm story-social-btn" onclick="likeStory(<?php echo $story['id']; ?>)">
                                                    <i class="fas fa-heart"></i> <span id="likes-<?php echo $story['id']; ?>"><?php echo $story['likes']; ?></span>
                                                </button>
                                                <button class="btn btn-sm story-social-btn" onclick="commentStory(<?php echo $story['id']; ?>)">
                                                    <i class="fas fa-comment"></i> <span><?php echo $story['comments']; ?></span>
                                                </button>
                                                <button class="btn btn-sm story-social-btn" onclick="shareStory(<?php echo $story['id']; ?>)">
                                                    <i class="fas fa-share"></i> <span><?php echo $story['shares']; ?></span>
                                                </button>
                                            </div>
                                            <button class="btn btn-primary" onclick="openStoryModal(<?php echo htmlspecialchars(json_encode($story), ENT_QUOTES, 'UTF-8'); ?>)">Read More</button>
                                        </div>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </div>
                </div>
                
                <!-- Pagination -->
                <?php
                $baseUrl = BASE_URL . '/stories.php';
require __DIR__ . '/includes/pagination.php';
?>
            </div>
        </div>
    </div>
</div>
<!-- Stories End -->

<!-- Modal -->
<?php
$modalId = 'storyModal';
$title = 'Story Details';
require __DIR__ . '/includes/modal.php';
?>

<script>
function openStoryModal(story) {
    // Construct full image URL
    const baseUrl = '<?php echo BASE_URL; ?>';
    const imageUrl = story.image ? `${baseUrl}/Banners-and-portraits/${story.image}` : null;
    
    const modalData = {
        title: story.title,
        description: story.content || story.description,
        image: imageUrl,
        thumbnail: imageUrl,
        meta: {
            'Region': story.region.charAt(0).toUpperCase() + story.region.slice(1),
            'Category': story.category.charAt(0).toUpperCase() + story.category.slice(1),
            'Date': new Date(story.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
            'Author': story.author
        },
        tags: [story.region, story.category],
        action_url: '#',
        action_text: 'Share Story'
    };
    openModal('storyModal', modalData);
}

function likeStory(storyId) {
    // TODO: Implement AJAX call to like story
    const likesElement = document.getElementById('likes-' + storyId);
    if (likesElement) {
        const currentLikes = parseInt(likesElement.textContent) || 0;
        likesElement.textContent = currentLikes + 1;
    }
}

function commentStory(storyId) {
    // TODO: Implement comment functionality
    alert('Comment functionality coming soon!');
}

function shareStory(storyId) {
    // TODO: Implement share functionality
    if (navigator.share) {
        navigator.share({
            title: 'GHI Story',
            text: 'Check out this inspiring story from Global Harmony Initiative',
            url: window.location.href
        });
    } else {
        // Fallback: copy to clipboard
        navigator.clipboard.writeText(window.location.href);
        alert('Link copied to clipboard!');
    }
}
</script>

