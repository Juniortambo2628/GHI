<?php
/**
 * Events & Activities Page
 * Global Harmony Initiative Website
 */

// Load configuration first
require_once __DIR__ . '/config/config.php';

use GHI\Models\Event;
use GHI\Models\Initiative;

$pageTitle = 'Events & Activities - ' . SITE_NAME;
$pageDescription = 'Join our upcoming events and activities, or explore past events that have made a difference in East Africa.';

require_once __DIR__ . '/includes/header.php';

// Pagination
$itemsPerPage = 12;
$currentPage = isset($_GET['page']) ? (int)$_GET['page'] : 1;
$currentPage = max(1, $currentPage);

// Search
$search = isset($_GET['search']) ? trim($_GET['search']) : '';

// Filters
$filters = [
    'initiative' => [
        'label' => 'Initiative',
        'type' => 'select',
        'options' => [
            '1' => 'School Fee Support Program',
            '2' => 'Community Health Clinics',
            '3' => 'Entrepreneurship Training',
            '4' => 'Women Leadership Program',
            '5' => 'Global Volunteer Network',
            '6' => 'Digital Learning Initiative',
        ],
    ],
    'status' => [
        'label' => 'Status',
        'type' => 'select',
        'options' => [
            'upcoming' => 'Upcoming',
            'ongoing' => 'Ongoing',
            'completed' => 'Completed',
        ],
    ],
];

// Get events from database
$eventModel = new Event();
$conditions = ['status' => 'published'];
$orderBy = 'event_date ASC';
$allEvents = $eventModel->all($conditions, $orderBy);

// Get initiatives for mapping
$initiativeModel = new Initiative();
$allInitiatives = $initiativeModel->all(['status' => 'published'], 'title ASC');
$initiativesById = [];
foreach ($allInitiatives as $init) {
    $initiativesById[$init['id']] = $init;
}

// Add initiative name and determine status based on date
$today = date('Y-m-d');
foreach ($allEvents as &$event) {
    $event['initiative'] = $initiativesById[$event['initiative_id']]['title'] ?? 'N/A';
    $event['date'] = $event['event_date'];
    // Determine status based on date
    if ($event['event_date'] >= $today) {
        $event['status'] = 'upcoming';
    } else {
        $event['status'] = 'completed';
    }
}
unset($event);

// Update filter options with actual initiatives
$filters['initiative']['options'] = [];
foreach ($allInitiatives as $init) {
    $filters['initiative']['options'][$init['id']] = $init['title'];
}

// Apply filters
$filteredEvents = $allEvents;
if (! empty($search)) {
    $filteredEvents = array_filter($filteredEvents, function ($event) use ($search) {
        return stripos($event['title'], $search) !== false || stripos($event['description'], $search) !== false;
    });
}

if (isset($_GET['filter']['initiative']) && ! empty($_GET['filter']['initiative'])) {
    $filteredEvents = array_filter($filteredEvents, function ($event) {
        return $event['initiative_id'] == $_GET['filter']['initiative'];
    });
}

if (isset($_GET['filter']['status']) && ! empty($_GET['filter']['status'])) {
    $filteredEvents = array_filter($filteredEvents, function ($event) {
        return $event['status'] === $_GET['filter']['status'];
    });
}

$filteredEvents = array_values($filteredEvents);
$totalItems = count($filteredEvents);
$totalPages = ceil($totalItems / $itemsPerPage);
$offset = ($currentPage - 1) * $itemsPerPage;
$events = array_slice($filteredEvents, $offset, $itemsPerPage);

// Sidebar options
$sidebarOptions = [
    'page_title' => 'Events & Activities',
    'show_search' => true,
    'show_filters' => true,
    'filters' => $filters,
    'current_page' => $currentPage,
    'total_pages' => $totalPages,
    'total_items' => $totalItems,
    'items_per_page' => $itemsPerPage,
    'base_url' => BASE_URL . '/events.php',
    'current_page_name' => 'events',
];
?>

<!-- Page Header Start -->
<div class="container-fluid page-header hero-events mb-5">
    <div class="container py-5">
        <nav aria-label="breadcrumb animated slideInDown mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="<?php echo BASE_URL; ?>/index.php">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Events & Activities</li>
            </ol>
        </nav>
        <h1 class="display-3 text-white mb-3 animated slideInDown">Events & Activities</h1>
    </div>
</div>
<!-- Page Header End -->

<!-- Events Start -->
<div class="container-fluid px-5">
    <div class="container-fluid px-5">
        <div class="row">
            <?php
            $options = $sidebarOptions;
require __DIR__ . '/includes/sidebar.php';
?>
            
            <div class="col-lg-9">
                <!-- Pagination Info and Grid/List Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <p class="mb-0">Showing <?php echo min(($currentPage - 1) * $itemsPerPage + 1, $totalItems); ?>-<?php echo min($currentPage * $itemsPerPage, $totalItems); ?> of <?php echo $totalItems; ?> results</p>
                    </div>
                    <?php
        $viewMode = 'grid';
$storageKey = 'viewMode_events';
require __DIR__ . '/includes/grid-list-toggle.php';
?>
                </div>
                
                <!-- Content Container -->
                <div class="content-container <?php echo $viewMode; ?>-view mt-4">
                    <div class="row g-0">
                        <?php if (empty($events)): ?>
                            <div class="col-12">
                                <p class="text-center py-5">No events found. Please try different search or filter criteria.</p>
                            </div>
                        <?php else: ?>
                            <?php foreach ($events as $event): ?>
                                <div class="col-md-6 col-lg-4 listing-item">
                                    <div class="card">
                                        <img src="<?php echo getImageUrl($event['image']); ?>" class="card-img-top" alt="<?php echo e($event['title']); ?>">
                                        <span class="badge"><?php echo e($event['initiative']); ?></span>
                                        <span class="badge badge-<?php echo $event['status']; ?>"><?php echo e(ucfirst($event['status'])); ?></span>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title"><?php echo e($event['title']); ?></h5>
                                            <p class="card-text"><?php echo e(truncate($event['description'], 100)); ?></p>
                                            <small class="text-white mb-2"><i class="fas fa-calendar me-1"></i><?php echo formatDate($event['date']); ?></small>
                                            <small class="text-white mb-3"><i class="fas fa-map-marker-alt me-1"></i><?php echo e($event['location']); ?></small>
                                            <button class="btn btn-primary" onclick="openEventModal(<?php echo htmlspecialchars(json_encode($event), ENT_QUOTES, 'UTF-8'); ?>)">View Details</button>
                                        </div>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </div>
                </div>
                
                <!-- Pagination -->
                <?php
                $baseUrl = BASE_URL . '/events.php';
require __DIR__ . '/includes/pagination.php';
?>
            </div>
        </div>
    </div>
</div>
<!-- Events End -->

<!-- Modal -->
<?php
$modalId = 'eventModal';
$title = 'Event Details';
require __DIR__ . '/includes/modal.php';
?>

<script>
function openEventModal(event) {
    // Construct full image URL
    const baseUrl = '<?php echo BASE_URL; ?>';
    const imageUrl = event.image ? `${baseUrl}/Banners-and-portraits/${event.image}` : null;
    
    const modalData = {
        title: event.title,
        description: event.description,
        image: imageUrl,
        thumbnail: imageUrl,
        meta: {
            'Initiative': event.initiative,
            'Date': new Date(event.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
            'Location': event.location,
            'Status': event.status.charAt(0).toUpperCase() + event.status.slice(1)
        },
        tags: [event.initiative, event.status],
        action_url: '<?php echo BASE_URL; ?>/get-involved.php?event=' + event.id,
        action_text: 'Get Involved'
    };
    openModal('eventModal', modalData);
}
</script>

<?php require_once __DIR__ . '/includes/footer.php'; ?>

