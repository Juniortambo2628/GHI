{
    "name": "global-harmony-initiative",
    "version": "1.0.0",
    "description": "Global Harmony Initiative - Nonprofit Organization Website",
    "type": "module",
    "scripts": {
        "format": "prettier --write \"**/*.{js,css,html,json}\"",
        "check-duplicates": "jscpd . --min-lines 5 --min-tokens 50",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint:js": "eslint js/**/*.js --fix",
        "lint:css": "stylelint '**/*.css' --fix",
        "type-check": "tsc --noEmit",
        "lint:all": "npm run lint:js && npm run lint:css && npm run type-check",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "css:process": "postcss css/**/*.css --dir dist/css",
        "docs:js": "typedoc"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.1.0",
        "@inertiajs/react": "^3.7.0",
        "@sentry/browser": "^7.80.0",
        "@vitejs/plugin-react": "^4.7.0",
        "aos": "^2.3.4",
        "axios": "^1.6.0",
        "browser-image-compression": "^2.0.2",
        "chart.js": "^4.4.0",
        "dayjs": "^1.11.0",
        "filepond": "^4.30.0",
        "filepond-plugin-file-validate-type": "^1.2.8",
        "filepond-plugin-image-preview": "^4.6.12",
        "filepond-plugin-image-resize": "^2.0.10",
        "form-serialize": "^0.7.2",
        "framer-motion": "^13.1.0",
        "gsap": "^3.13.0",
        "jspdf": "^3.0.3",
        "jspdf-autotable": "^5.0.2",
        "locomotive-scroll": "^4.1.4",
        "lodash-es": "^4.17.21",
        "luxon": "^3.7.2",
        "micromodal": "^0.4.10",
        "notyf": "^3.2.0",
        "quill": "^1.3.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-easy-crop": "^6.2.3",
        "sortablejs": "^1.15.6",
        "tabulator-tables": "^5.5.0",
        "validator": "^13.15.23",
        "vanilla-lazyload": "^19.1.3",
        "xlsx": "^0.18.5",
        "zod": "^3.22.0",
        "zustand": "^4.4.0"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@types/node": "^24.10.1",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "baseline-browser-mapping": "^2.11.18",
        "eslint": "^8.50.0",
        "eslint-config-prettier": "^9.0.0",
        "jscpd": "^3.5.0",
        "jsdom": "^27.2.0",
        "laravel-vite-plugin": "^2.1.0",
        "postcss": "^8.4.31",
        "prettier": "^3.0.0",
        "stylelint": "^16.25.0",
        "stylelint-config-standard": "^39.0.1",
        "tailwindcss": "^3.1.0",
        "typedoc": "^0.28.14",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vitest": "^3.2.7"
    },
    "keywords": [
        "nonprofit",
        "charity",
        "website"
    ],
    "author": "Global Harmony Initiative",
    "license": "MIT"
}
