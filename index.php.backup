<script>
// Event Modal Function
function openEventModal(event) {
    // Construct full image URL
    const baseUrl = '<?php echo BASE_URL; ?>';
    const imageUrl = event.image ? `${baseUrl}/Banners-and-portraits/${event.image}` : null;
    
    const modalData = {
        title: event.title,
        description: event.description,
        image: imageUrl,
        thumbnail: imageUrl,
        meta: {
            'Initiative': event.initiative,
            'Date': new Date(event.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
            'Location': event.location,
            'Status': event.status.charAt(0).toUpperCase() + event.status.slice(1)
        },
        tags: [event.initiative, event.status],
        action_url: '<?php echo BASE_URL; ?>/get-involved.php?event=' + event.id,
        action_text: 'Get Involved'
    };
    openModal('eventModal', modalData);
}

// Like functionality
document.querySelectorAll('.btn-like').forEach(button => {
    button.addEventListener('click', function() {
        const storyId = this.getAttribute('data-story-id');
        const likeCount = this.querySelector('.like-count');
        const heartIcon = this.querySelector('.fa-heart');
        
        // Toggle liked state
        if (this.classList.contains('liked')) {
            this.classList.remove('liked');
            heartIcon.classList.remove('text-danger');
            likeCount.textContent = parseInt(likeCount.textContent) - 1;
        } else {
            this.classList.add('liked');
            heartIcon.classList.add('text-danger');
            likeCount.textContent = parseInt(likeCount.textContent) + 1;
        }
        
        // Send like to server
        fetch('<?php echo BASE_URL; ?>/api/stories.php', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                action: 'like',
                story_id: storyId
            })
        }).catch(error => console.error('Error:', error));
    });
});

// Share functionality
document.querySelectorAll('.btn-share').forEach(button => {
    button.addEventListener('click', function() {
        const storyId = this.getAttribute('data-story-id');
        const storyTitle = this.getAttribute('data-story-title');
        const storyUrl = '<?php echo BASE_URL; ?>/stories.php?id=' + storyId;
        
        if (navigator.share) {
            navigator.share({
                title: storyTitle,
                text: 'Check out this impact story from Global Harmony Initiative',
                url: storyUrl
            }).catch(error => console.error('Error sharing:', error));
        } else {
            // Fallback: copy to clipboard
            navigator.clipboard.writeText(storyUrl).then(() => {
                alert('Story link copied to clipboard!');
            }).catch(error => {
                // Fallback: show URL in prompt
                prompt('Copy this link to share:', storyUrl);
            });
        }
    });
});
</script>

