<?php
/**
 * Home Page
 * Global Harmony Initiative Website
 */

// Load configuration first
require_once __DIR__ . '/config/config.php';

$pageTitle = SITE_NAME . ' - ' . SITE_TAGLINE;
$pageDescription = 'Global Harmony Initiative is a U.S.-registered 501(c)(3) nonprofit organization working in East Africa to create positive change through education, healthcare, and community development.';

require_once __DIR__ . '/includes/header.php';

use GHI\Models\Event;
use GHI\Models\ImpactActivity;
use GHI\Models\Initiative;
use GHI\Models\Story;

// Get objectives from constants (these are static content)
$objectives = OBJECTIVES;
$coreValues = CORE_VALUES;
$quotes = INSPIRATIONAL_QUOTES;
$randomQuote = $quotes[array_rand($quotes)];

// Get dynamic data from database (with caching)
$initiativeModel = new Initiative();
$impactModel = new ImpactActivity();
$storyModel = new Story();
$eventModel = new Event();

// Get initiatives for "Our Initiatives" section (limit 6) - cached for 1 hour
$initiatives = cache_remember('homepage.initiatives', function() use ($initiativeModel) {
    return $initiativeModel->all(['status' => 'published'], 'created_at DESC', 6);
}, 3600);

// Get impact stories for "Planting Seeds of Hope" section (limit 3) - cached for 1 hour
$impactStories = cache_remember('homepage.impact_stories', function() use ($impactModel) {
    return $impactModel->all(['status' => 'published'], 'display_order ASC, created_at DESC', 3);
}, 3600);

// Get stories for "Our Impact" section (limit 6) - cached for 1 hour
$stories = cache_remember('homepage.stories', function() use ($storyModel) {
    return $storyModel->all(['status' => 'published'], 'created_at DESC', 6);
}, 3600);

// Get upcoming events for "Events & Activities" section (limit 3) - cached for 30 minutes
$upcomingEvents = cache_remember('homepage.upcoming_events', function() use ($eventModel) {
    return $eventModel->getUpcoming(3);
}, 1800);

// Get initiatives for mapping event initiative names - cached for 1 hour
$allInitiatives = cache_remember('homepage.all_initiatives', function() use ($initiativeModel) {
    return $initiativeModel->all(['status' => 'published'], 'title ASC');
}, 3600);
$initiativesById = [];
foreach ($allInitiatives as $init) {
    $initiativesById[$init['id']] = $init;
}

// Process events to add initiative name and format date
foreach ($upcomingEvents as &$event) {
    $event['date'] = $event['event_date'];
    $event['initiative'] = $initiativesById[$event['initiative_id']]['title'] ?? 'General';
    // Determine status based on date
    $today = date('Y-m-d');
    if ($event['event_date'] >= $today) {
        $event['status'] = 'upcoming';
    } else {
        $event['status'] = 'completed';
    }
}
unset($event);

// Get recent events for gallery labels - cached for 1 hour
$recentEvents = cache_remember('homepage.recent_events', function() use ($eventModel) {
    return $eventModel->all(['status' => 'published'], 'event_date DESC', 10);
}, 3600);

// Category to objective mapping for stories
$categoryToObjective = [
    'livelihood' => 'Poverty Alleviation & Livelihoods',
    'education' => 'Education Access & Youth Development',
    'health' => 'Health & Well-being',
    'empowerment' => 'Community Empowerment',
    'partnerships' => 'Global Partnerships & Awareness',
];
?>

