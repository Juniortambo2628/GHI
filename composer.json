{
  "name": "global-harmony-initiative/website",
  "description": "Global Harmony Initiative - Nonprofit Organization Website",
  "type": "project",
  "require": {
    "php": "^8.2",
    "cocur/slugify": "^4.6",
    "delight-im/auth": "^8.3",
    "doctrine/dbal": "^3.0",
    "dompdf/dompdf": "^3.1",
    "fakerphp/faker": "^1.24",
    "filp/whoops": "^2.18",
    "guzzlehttp/guzzle": "^7.0",
    "intervention/image": "^3.11",
    "league/csv": "^9.27",
    "league/flysystem": "^3.0",
    "monolog/monolog": "^3.0",
    "pagerfanta/pagerfanta": "^4.7",
    "stripe/stripe-php": "^19.0",
    "symfony/cache": "^6.0",
    "symfony/dotenv": "^6.0",
    "symfony/event-dispatcher": "^6.0",
    "symfony/filesystem": "^6.0",
    "symfony/mailer": "^6.0",
    "symfony/messenger": "^7.3",
    "symfony/rate-limiter": "^7.3",
    "symfony/security-csrf": "^6.0",
    "symfony/validator": "^6.0",
    "twig/twig": "^3.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "pestphp/pest": "^3.8",
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^1.12",
    "rector/rector": "^1.2",
    "robmorgan/phinx": "^0.15",
    "squizlabs/php_codesniffer": "^4.0",
    "symfony/console": "^7.3",
    "symfony/var-dumper": "^7.3",
    "vimeo/psalm": "^6.5"
  },
  "autoload": {
    "psr-4": {
      "GHI\\": "src/"
    }
  },
  "scripts": {
    "cs-fix": "php-cs-fixer fix",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "phpstan": "phpstan analyse --memory-limit=256M",
    "psalm": "psalm --show-info=true",
    "phpcs": "phpcs --standard=PSR12 src admin",
    "phpcbf": "phpcbf --standard=PSR12 src admin",
    "phpmd": "phpmd . text phpmd.xml",
    "rector": "rector process --dry-run",
    "rector:refactor": "rector process",
    "quality:check": [
      "@phpstan",
      "@phpcs"
    ],
    "quality:fix": [
      "@cs-fix",
      "@rector:refactor"
    ],
    "qa": [
      "@phpstan",
      "@phpcs"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "license": "proprietary"
}
