a:5:{i:0;a:10:{s:2:"id";i:16;s:5:"title";s:17:"Education for All";s:4:"slug";s:17:"education-for-all";s:11:"description";s:259:"From paying school fees for bright students to supporting digital learning initiatives, GHI ensures that children and youth have the tools to shape their futures. We believe education is not a privilege — it's a foundation for building thriving communities.";s:5:"quote";s:51:"Education is not a privilege — it's a foundation.";s:5:"image";s:32:"pexels-lagosfoodbank-6472487.jpg";s:13:"display_order";i:1;s:6:"status";s:6:"active";s:10:"created_at";s:19:"2025-10-19 20:08:15";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:1;a:10:{s:2:"id";i:17;s:5:"title";s:17:"Healthcare Access";s:4:"slug";s:17:"healthcare-access";s:11:"description";s:197:"We strengthen access to healthcare, nutrition, and clean water through partnerships with local clinics and community health volunteers. Healthy families are the cornerstone of thriving communities.";s:5:"quote";s:61:"Healthy families are the cornerstone of thriving communities.";s:5:"image";s:32:"pexels-lagosfoodbank-8054617.jpg";s:13:"display_order";i:2;s:6:"status";s:6:"active";s:10:"created_at";s:19:"2025-07-20 04:23:16";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:2;a:10:{s:2:"id";i:18;s:5:"title";s:20:"Economic Empowerment";s:4:"slug";s:20:"economic-empowerment";s:11:"description";s:213:"We support grassroots entrepreneurship, vocational training, and financial inclusion programs that help families generate income and build resilience. Every small business started today can feed a family tomorrow.";s:5:"quote";s:70:"Because every small business started today can feed a family tomorrow.";s:5:"image";s:36:"pexels-speakmediauganda-33749783.jpg";s:13:"display_order";i:3;s:6:"status";s:6:"active";s:10:"created_at";s:19:"2024-12-02 19:29:34";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:3;a:10:{s:2:"id";i:19;s:5:"title";s:21:"Community Development";s:4:"slug";s:21:"community-development";s:11:"descriptio