a:15:{i:0;a:11:{s:2:"id";i:70;s:5:"title";s:27:"Shelter Improvement Project";s:4:"slug";s:27:"shelter-improvement-project";s:11:"description";s:106:"Rebuilding and repairing homes for elderly and vulnerable community members, restoring safety and dignity.";s:7:"content";s:268:"This project focuses on improving housing conditions for those who cannot afford repairs. We rebuild damaged roofs, repair walls, improve ventilation, and ensure homes are safe and weatherproof. This work restores dignity and provides security for vulnerable families.";s:5:"image";s:41:"pexels-finalchoice-147015110-34599374.jpg";s:8:"category";s:11:"empowerment";s:8:"cause_id";i:19;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-10-27 11:30:33";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:1;a:11:{s:2:"id";i:67;s:5:"title";s:20:"Microfinance Program";s:4:"slug";s:20:"microfinance-program";s:11:"description";s:111:"Offering small loans and financial literacy training to help individuals and groups start or expand businesses.";s:7:"content";s:253:"Our Microfinance Program provides access to credit for those who cannot access traditional banking services. We offer small loans with reasonable terms, financial literacy training, and ongoing support to ensure successful repayment and business growth.";s:5:"image";s:32:"pexels-caleboquendo-34612590.jpg";s:8:"category";s:10:"livelihood";s:8:"cause_id";i:18;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-10-24 05:57:08";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:2;a:11:{s:2:"id";i:64;s:5:"title";s:30:"Women Entrepreneurship Program";s:4:"slug";s:30:"women-entrepreneurship-program";s:11:"description";s:108:"Empowering women with business skills, microfinance, and mentorship to start and grow their own enterprises.";s:7:"content";s:309:"This program focuses on empowering women economically through entrepreneurship. We provide business training, access to microfinance loans, mentorship from successful businesswomen, and networking opportunities. Many participants have started successful businesses that support their families and create jobs.";s:5:"image";s:36:"pexels-speakmediauganda-34222337.jpg";s:8:"category";s:11:"empowerment";s:8:"cause_id";i:19;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-10-21 03:57:05";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:3;a:11:{s:2:"id";i:61;s:5:"title";s:24:"Community Health Clinics";s:4:"slug";s:24:"community-health-clinics";s:11:"description";s:111:"Supporting local health facilities with resources, training, and medical supplies to improve healthcare access.";s:7:"content";s:255:"We partner with existing community health clinics to strengthen their capacity. This includes providing medical equipment, training healthcare workers, organizing health awareness campaigns, and facilitating regular health check-ups for community members.";s:5:"image";s:36:"pexels-speakmediauganda-33749783.jpg";s:8:"category";s:6:"health";s:8:"cause_id";i:17;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-10-14 22:46:00";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:4;a:11:{s:2:"id";i:69;s:5:"title";s:25:"Community Feeding Program";s:4:"slug";s:25:"community-feeding-program";s:11:"description";s:108:"Organizing food distribution events to ensure families and children in need have access to nutritious meals.";s:7:"content";s:262:"Our Community Feeding Programs provide meals to families facing food insecurity. We work with local partners to identify those in need, organize food distribution events, and ensure that nutritious meals reach children, elderly, and vulnerable community members.";s:5:"image";s:63:"pexels-ezeguna_graphy-sulaiman-muhammad-2153324075-34536427.jpg";s:8:"category";s:6:"health";s:8:"cause_id";i:17;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-08-26 02:27:03";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:5;a:11:{s:2:"id";i:63;s:5:"title";s:27:"Vocational Training Centers";s:4:"slug";s:27:"vocational-training-centers";s:11:"description";s:124:"Offering skills training in trades like carpentry, tailoring, mechanics, and agriculture to create employment opportunities.";s:7:"content";s:291:"Our Vocational Training Centers provide hands-on training in marketable skills. Students learn practical trades, receive mentorship, and are connected with job opportunities or supported to start their own businesses. Graduates often become trainers themselves, creating a multiplier effect.";s:5:"image";s:36:"pexels-speakmediauganda-33749791.jpg";s:8:"category";s:10:"livelihood";s:8:"cause_id";i:18;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-08-05 00:06:03";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:6;a:11:{s:2:"id";i:60;s:5:"title";s:27:"Digital Learning Initiative";s:4:"slug";s:27:"digital-learning-initiative";s:11:"description";s:109:"Bringing technology and digital literacy to underserved communities, preparing youth for the digital economy.";s:7:"content";s:286:"The Digital Learning Initiative equips students and young adults with essential computer skills and access to online educational resources. We set up computer labs in community centers and schools, provide training workshops, and connect learners with online courses and certifications.";s:5:"image";s:32:"pexels-lagosfoodbank-8054617.jpg";s:8:"category";s:9:"education";s:8:"cause_id";i:16;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-08-01 14:29:55";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:7;a:11:{s:2:"id";i:65;s:5:"title";s:24:"Youth Mentorship Program";s:4:"slug";s:24:"youth-mentorship-program";s:11:"description";s:106:"Connecting young people with mentors who guide them in education, career development, and personal growth.";s:7:"content";s:268:"The Youth Mentorship Program pairs young people with experienced mentors from various fields. Mentors provide guidance on education choices, career paths, personal development, and life skills. Regular workshops and networking events help build a supportive community.";s:5:"image";s:36:"pexels-speakmediauganda-34249567.jpg";s:8:"category";s:9:"education";s:8:"cause_id";i:16;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-07-19 08:20:05";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:8;a:11:{s:2:"id";i:71;s:5:"title";s:25:"Youth Leadership Training";s:4:"slug";s:25:"youth-leadership-training";s:11:"description";s:111:"Developing leadership skills in young people to prepare them for roles in community development and governance.";s:7:"content";s:272:"Our Youth Leadership Training program teaches young people essential leadership skills, public speaking, project management, and community organizing. Graduates often take on leadership roles in their communities, organizing initiatives and advocating for positive change.";s:5:"image";s:40:"pexels-lom-doudou-351893580-34617622.jpg";s:8:"category";s:11:"empowerment";s:8:"cause_id";i:19;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-07-09 14:37:20";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:9;a:11:{s:2:"id";i:73;s:5:"title";s:23:"Skills Exchange Program";s:4:"slug";s:23:"skills-exchange-program";s:11:"description";s:126:"Facilitating knowledge sharing between international volunteers and local communities, creating mutual learning opportunities.";s:7:"content";s:247:"The Skills Exchange Program creates opportunities for mutual learning. International volunteers share their expertise while learning from local knowledge and practices. This two-way exchange enriches both parties and creates sustainable solutions.";s:5:"image";s:31:"pexels-seyhmuskino-30668435.jpg";s:8:"category";s:12:"partnerships";s:8:"cause_id";i:20;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-06-28 10:00:33";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:10;a:11:{s:2:"id";i:72;s:5:"title";s:26:"Health Awareness Campaigns";s:4:"slug";s:26:"health-awareness-campaigns";s:11:"description";s:122:"Organizing community health education sessions on topics like nutrition, hygiene, disease prevention, and maternal health.";s:7:"content";s:267:"We conduct regular health awareness campaigns in communities, covering topics such as nutrition, hygiene, disease prevention, maternal and child health, and mental wellness. These campaigns include workshops, demonstrations, and distribution of educational materials.";s:5:"image";s:35:"pexels-mo-liban-3049584-5648154.jpg";s:8:"category";s:6:"health";s:8:"cause_id";i:17;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-06-07 09:04:14";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:11;a:11:{s:2:"id";i:68;s:5:"title";s:24:"Global Volunteer Network";s:4:"slug";s:24:"global-volunteer-network";s:11:"description";s:109:"Connecting volunteers from around the world with local communities to share skills, knowledge, and resources.";s:7:"content";s:283:"The Global Volunteer Network facilitates meaningful volunteer experiences. Volunteers contribute their skills in education, healthcare, technology, and business development while learning about local cultures and challenges. This creates lasting connections and mutual understanding.";s:5:"image";s:43:"pexels-g-star-media-2150953934-32968674.jpg";s:8:"category";s:12:"partnerships";s:8:"cause_id";i:20;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-05-26 19:13:29";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:12;a:11:{s:2:"id";i:66;s:5:"title";s:31:"Agricultural Support Initiative";s:4:"slug";s:31:"agricultural-support-initiative";s:11:"description";s:113:"Providing farmers with seeds, tools, training, and market access to improve agricultural productivity and income.";s:7:"content";s:223:"We support smallholder farmers with improved seeds, farming tools, training on modern agricultural techniques, and connections to markets. This helps increase crop yields, improve food security, and boost household incomes.";s:5:"image";s:29:"pexels-elsaboath-28586115.jpg";s:8:"category";s:10:"livelihood";s:8:"cause_id";i:18;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-05-25 03:44:11";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:13;a:11:{s:2:"id";i:59;s:5:"title";s:26:"School Fee Support Program";s:4:"slug";s:26:"school-fee-support-program";s:11:"description";s:146:"Providing financial assistance to promising students from low-income families, ensuring they can continue their education and pursue their dreams.";s:7:"content";s:375:"Our School Fee Support Program identifies bright students facing financial barriers and provides the necessary funding to keep them in school. We work directly with schools and families to ensure transparency and accountability. This program has helped hundreds of students continue their education, with many going on to pursue higher education and become community leaders.";s:5:"image";s:32:"pexels-lagosfoodbank-6472487.jpg";s:8:"category";s:9:"education";s:8:"cause_id";i:16;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-05-19 01:58:54";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}i:14;a:11:{s:2:"id";i:62;s:5:"title";s:20:"Clean Water Projects";s:4:"slug";s:20:"clean-water-projects";s:11:"description";s:132:"Installing wells, water purification systems, and water storage facilities to ensure communities have access to safe drinking water.";s:7:"content";s:236:"Access to clean water is fundamental to health and well-being. Our Clean Water Projects involve community consultation, well drilling, installation of water purification systems, and training on water conservation and hygiene practices.";s:5:"image";s:36:"pexels-speakmediauganda-33749790.jpg";s:8:"category";s:6:"health";s:8:"cause_id";i:17;s:6:"status";s:9:"published";s:10:"created_at";s:19:"2025-03-20 22:40:05";s:10:"updated_at";s:19:"2025-11-08 09:05:21";}}