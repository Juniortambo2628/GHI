<?php
/**
 * Our Causes Page
 * Global Harmony Initiative Website
 */

// Load configuration first
require_once __DIR__ . '/config/config.php';

use GHI\Models\Cause;

$pageTitle = 'Our Causes - ' . SITE_NAME;
$pageDescription = 'Explore our causes and learn how we are making a difference in East Africa through education, healthcare, and community development.';

require_once __DIR__ . '/includes/header.php';

// Pagination
$itemsPerPage = 12;
$currentPage = isset($_GET['page']) ? (int)$_GET['page'] : 1;
$currentPage = max(1, $currentPage);

// Search
$search = isset($_GET['search']) ? trim($_GET['search']) : '';

// Filters
$filters = [
    'objective' => [
        'label' => 'Core Objective',
        'type' => 'select',
        'options' => [
            'poverty' => 'Poverty Alleviation & Livelihoods',
            'education' => 'Education Access & Youth Development',
            'health' => 'Health & Well-being',
            'empowerment' => 'Community Empowerment',
            'partnerships' => 'Global Partnerships & Awareness',
        ],
    ],
    'status' => [
        'label' => 'Status',
        'type' => 'select',
        'options' => [
            'active' => 'Active',
            'completed' => 'Completed',
            'upcoming' => 'Upcoming',
        ],
    ],
];

// Get causes from database
$causeModel = new Cause();
$conditions = ['status' => 'active'];
$orderBy = 'display_order ASC, created_at DESC';
$allCauses = $causeModel->all($conditions, $orderBy);

// Apply filters
$filteredCauses = $allCauses;
if (! empty($search)) {
    $filteredCauses = array_filter($filteredCauses, function ($cause) use ($search) {
        return stripos($cause['title'], $search) !== false || stripos($cause['description'], $search) !== false;
    });
}

if (isset($_GET['filter']['status']) && ! empty($_GET['filter']['status'])) {
    $filteredCauses = array_filter($filteredCauses, function ($cause) {
        return $cause['status'] === $_GET['filter']['status'];
    });
}

$filteredCauses = array_values($filteredCauses);
$totalItems = count($filteredCauses);
$totalPages = ceil($totalItems / $itemsPerPage);
$offset = ($currentPage - 1) * $itemsPerPage;
$causes = array_slice($filteredCauses, $offset, $itemsPerPage);

// Sidebar options
$sidebarOptions = [
    'page_title' => 'Our Causes',
    'show_search' => true,
    'show_filters' => true,
    'filters' => $filters,
    'current_page' => $currentPage,
    'total_pages' => $totalPages,
    'total_items' => $totalItems,
    'items_per_page' => $itemsPerPage,
    'base_url' => BASE_URL . '/causes.php',
    'current_page_name' => 'causes',
];
?>

<!-- Page Header Start -->
<div class="container-fluid page-header hero-causes mb-5">
    <div class="container py-5">
        <nav aria-label="breadcrumb animated slideInDown mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="<?php echo BASE_URL; ?>/index.php">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Our Causes</li>
            </ol>
        </nav>
        <h1 class="display-3 text-white mb-3 animated slideInDown">Our Causes</h1>
    </div>
</div>
<!-- Page Header End -->

<!-- Causes Start -->
<div class="container-fluid px-5">
    <div class="container-fluid px-5">
        <div class="row">
            <?php
            $options = $sidebarOptions;
require __DIR__ . '/includes/sidebar.php';
?>
            
            <div class="col-lg-9">
                <!-- Pagination Info and Grid/List Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <p class="mb-0">Showing <?php echo min(($currentPage - 1) * $itemsPerPage + 1, $totalItems); ?>-<?php echo min($currentPage * $itemsPerPage, $totalItems); ?> of <?php echo $totalItems; ?> results</p>
                    </div>
                    <?php
        $viewMode = 'grid';
$storageKey = 'viewMode_causes';
require __DIR__ . '/includes/grid-list-toggle.php';
?>
                </div>
                
                <!-- Content Container -->
                <div class="content-container <?php echo $viewMode; ?>-view mt-4">
                    <div class="row g-0">
                        <?php if (empty($causes)): ?>
                            <div class="col-12">
                                <p class="text-center py-5">No causes found. Please try different search or filter criteria.</p>
                            </div>
                        <?php else: ?>
                            <?php foreach ($causes as $cause): ?>
                                <div class="col-md-6 col-lg-4 listing-item">
                                    <div class="card">
                                        <img src="<?php echo getImageUrl($cause['image']); ?>" class="card-img-top" alt="<?php echo e($cause['title']); ?>">
                                        <?php if (! empty($cause['quote'])): ?>
                                            <span class="badge bg-primary"><?php echo e(truncateWords($cause['quote'], 5)); ?></span>
                                        <?php endif; ?>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title"><?php echo e($cause['title']); ?></h5>
                                            <p class="card-text"><?php echo e(truncate($cause['description'], 100)); ?></p>
                                            <button class="btn btn-primary" onclick="openCauseModal(<?php echo htmlspecialchars(json_encode($cause), ENT_QUOTES, 'UTF-8'); ?>)">View Details</button>
                                        </div>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </div>
                </div>
                
                <!-- Pagination -->
                <?php
                $baseUrl = BASE_URL . '/causes.php';
require __DIR__ . '/includes/pagination.php';
?>
            </div>
        </div>
    </div>
</div>
<!-- Causes End -->

<!-- Modal -->
<?php
$modalId = 'causeModal';
$title = 'Cause Details';
require __DIR__ . '/includes/modal.php';
?>

<script>
function openCauseModal(cause) {
    // Construct full image URL
    const baseUrl = '<?php echo BASE_URL; ?>';
    const imageUrl = cause.image ? `${baseUrl}/Banners-and-portraits/${cause.image}` : null;
    
    const modalData = {
        title: cause.title,
        description: cause.description,
        image: imageUrl,
        thumbnail: imageUrl,
        meta: {
            'Core Objective': cause.objective ? cause.objective.charAt(0).toUpperCase() + cause.objective.slice(1) : 'N/A',
            'Status': cause.status.charAt(0).toUpperCase() + cause.status.slice(1)
        },
        tags: cause.objective ? [cause.objective, cause.status] : [cause.status],
        action_url: '<?php echo BASE_URL; ?>/initiatives.php?cause=' + cause.id,
        action_text: 'View Related Initiatives'
    };
    openModal('causeModal', modalData);
}
</script>

<?php require_once __DIR__ . '/includes/footer.php'; ?>

